R DA PISTA E IR PARA O ACOSTAMENTO E DECIDIMOS INTERCEPTA-LO PARA VER SE HAVIA ALGUM PROBLEMA COM ELE,  E NO DECORRER DO PERCURSO, AO TENTAR PARAR O MESMO PARA NOS DAR MAIS INFORMAÇÕES,  ESTE NAO PAROU, SENDO QUE FOI LIGADO A SIRENE, O INTERMITENTE, CONTUDO, AINDA FAZIA MOVIMENTOS DE ZIGUE-ZAGUE NA PISTA, COLOCANDO EM RISCO A VIDA DE OUTROS CONDUTORES. POREM, NAO OBTIVEMOS  EXITO ALGUM. O MESMO APENAS PAROU NA ENTRADA DE LAGOA GRANDE  QUANDO UM DOS SEUS PNEUS DO LADO DIREITO FUROU. NAQUELE MOMENTO  FOI SOLICITADO PARA O MESMO DESCESSE DO VEÍCULO , ONDE FOI VISUALIZADO SEU ESTADO DE VISIVEL EMBRIAGUEZ  ALCOOLICA, FOI ENCONTRADO UMA LATA DE CERVEJA AINDA FRIA NA CABINE DO CONDUTOR, SENDO QUE O INFRATOR AINDA TENTOU PEGAR A LATA DE CERVEJA PRA SE LIVRAR DA PROVA. REALIZANDO BUSCAS NA CABINE DO VEICULO COM O APOIO DO EFETIVO DA  ROCAM, TAMBÉM  FOI ENCONTRADO UM PRATO COM INDICIOS DE HAVER USO DE ENTORPECENTE RECENTEMENTE  E DOIS SAQUINHOS PLASTICOS COM RESTOS DE UM PO BRANCO (MATERIAL APREENDIDO).\nA CARRETA FICOU ESTACIONADA NO POSTO DE JUCA, EM FRENTE AO POSTO ROSA DE SARON, CARREGADO COM PO DE GESSO E O SR JUNIOR FOI CONDUZIDO ATE A DELEGACIA DE CABROBO, PARA AS PROVIDENCIAS , SEM SOFRER NENHUM DANO FÍSICO  OU PSICOLÓGICO. ","RESPONSAVEIS":[{"ID_USUARIO":"101a3e8c-268d-46d9-881b-f247a55c1c63","NOME_COMPLETO":"JULIO CÉSAR SANTOS PINHEIRO","NOME_MAE":"IVANILDE SANTOS PINHEIRO","NOME_PAI":"FRANCISCO FERREIRA PINHEIRO","DATA_NASCIMENTO":"18/01/1970","MATRICULA":"9209972","RG":"40428","EMAIL":"julio_cesar@pm.pe.gov.br","SEXO":"M","ID_CARGO":28,"CARGO":"2º SARGENTO","ID_ORGANIZACAO":2132,"ORGANIZACAO_DISPOSICAO":"7ª CIPM","DISPONIVEL":1,"ID_ACESSO":0,"PRIMEIRO_ACESSO":false,"STATS":{"TOTAL":4,"LOCAL":2,"DELEGACIA":2,"TCO_LOCAL":0},"CD_TIPO_ENVOLVIMENTO":0},{"ID_USUARIO":"edb4c232-95fb-4818-899b-4723b9a8e1e1","NOME_COMPLETO":"RONDINNELLE DOS SANTOS SILVA","DATA_NASCIMENTO":"21/04/1978","NOME_MAE":"MARIA DE LOURDES DOS SANTOS SILVA","NOME_PAI":"GILBERTO RODRIGUES DA SILVA","